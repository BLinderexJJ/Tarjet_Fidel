# Copia este archivo como `.env` si necesitas cambiar los valores por defecto.
#
# Activa la verificación obligatoria de App Check en las Cloud Functions
# DESPUÉS de registrar la app web en Firebase App Check y de compilar Flutter
# con --dart-define=RECAPTCHA_SITE_KEY=...
#
# Si lo dejas en false, las funciones siguen protegidas por autenticación y
# reglas de Firestore, pero no exigen token de App Check.
ENFORCE_APP_CHECK=false
